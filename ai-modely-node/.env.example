# Připojení k databázi MongoDB (u hostingu ji najdete ve svém clusteru)
MONGO_URI=

# Tajný klíč pro podepisování přihlašovacích tokenů
JWT_SECRET=

# Port, na kterém server poslouchá
PORT=5000

# Volitelný token pro Hugging Face API (bez něj stačí veřejná data)
HUGGINGFACE_API_KEY=

# ---------------------------------------------------------------------------
# Generování českých textů (popisky a přehledy z dokumentace)
#
# POZOR: tento soubor je uložený v gitu, takže sem nikdy nepatří skutečný klíč.
# Ten patří jen do .env (ten je ignorovaný). Zde nechávejte prázdné hodnoty.
#
# Poskytovatelů může být víc: první bez čísla, záložní s _2, _3… až _10 (SUMMARY_API_URL_2,
# SUMMARY_MODEL_2, SUMMARY_API_KEY_2). Zkoušejí se popořadě, takže vyčerpaný limit
# u jednoho provoz nezastaví. Klíč se u stejné služby dědí z prvního poskytovatele,
# ale každá jiná služba (Gemini, OpenRouter, Mistral…) potřebuje vlastní klíč.
#
# Klíč je volitelný. Když je nastavený, aplikace si popisky pro modely, které jsou
# na stránce vidět, doplňuje sama za běhu (nejvýš tři na jedno vyžádání) a ukládá je
# do databáze, takže se každý model generuje jen jednou.
#
# Vyhovuje jakákoli služba s OpenAI kompatibilním rozhraním. Příklady:
#
#   Groq (zdarma, bez karty) - denní limit 200 000 tokenů platí pro každý model
#   zvlášť, proto se vyplatí mít v záloze další modely. Groq má ovšem zdarma jen
#   pět textových modelů (openai/gpt-oss-120b, openai/gpt-oss-20b,
#   openai/gpt-oss-safeguard-20b, qwen/qwen3.8-27b, allam-2-7b), takže zbylé kvóty
#   musí zajistit jiné služby:
#     SUMMARY_API_URL=https://api.groq.com/openai/v1
#     SUMMARY_MODEL=openai/gpt-oss-120b
#     SUMMARY_REASONING_EFFORT=low         (jen gpt-oss modely; jiné služby parametr neznají)
#     SUMMARY_API_URL_2=https://api.groq.com/openai/v1
#     SUMMARY_MODEL_2=openai/gpt-oss-20b
#     SUMMARY_REASONING_EFFORT_2=low
#     SUMMARY_API_URL_3=https://api.groq.com/openai/v1
#     SUMMARY_MODEL_3=qwen/qwen3.8-27b     (reasoning_effort nezná, proto se vynechává)
#     SUMMARY_API_URL_4=https://api.groq.com/openai/v1
#     SUMMARY_MODEL_4=allam-2-7b
#     SUMMARY_API_URL_5=https://api.groq.com/openai/v1
#     SUMMARY_MODEL_5=openai/gpt-oss-safeguard-20b
#
#   Google Gemini (free tier, bez platební karty, přes 500 požadavků denně)
#     SUMMARY_API_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     SUMMARY_API_KEY=<klíč z https://aistudio.google.com/apikey>
#     SUMMARY_MODEL=gemini-2.5-flash-lite
#     Druhý Gemini model = další samostatná denní kvóta (klíč stačí jeden):
#     SUMMARY_MODEL_2=gemini-2.5-flash
#
#   OpenRouter (free modely končící :free; zdarma 50 požadavků denně, 1 000 po
#   zaplacení 10 USD - denní limit je společný pro všechny :free modely jednoho účtu)
#     SUMMARY_API_URL=https://openrouter.ai/api/v1
#     SUMMARY_MODEL=google/gemma-4-31b-it:free
#
#   Mistral (free tier)
#     SUMMARY_API_URL=https://api.mistral.ai/v1
#     SUMMARY_MODEL=mistral-small-latest
#
#   xAI Grok (placený)
#     SUMMARY_API_URL=https://api.x.ai/v1
#     SUMMARY_MODEL=<název modelu podle dokumentace xAI>
#
#   Lokální Ollama (zdarma a bez omezení, klíč nepotřebuje)
#     SUMMARY_API_URL=http://localhost:11434/v1
#     SUMMARY_MODEL=qwen3:8b
# ---------------------------------------------------------------------------
SUMMARY_API_KEY=
SUMMARY_API_URL=https://api.groq.com/openai/v1
SUMMARY_MODEL=openai/gpt-oss-120b

# ---------------------------------------------------------------------------
# Automatické doplňování chybějících textů (denní plánovač)
#
# Server kromě doplňování při prohlížení sám jednou denně zařadí do fronty
# všechny modely, kterým chybí popisek nebo přehledy (jako npm run generate:content,
# jen bez čekání na dodělání - úkoly si vezme běžící zpracovatel fronty).
# Hned po startu (probuzení hostingu) se spustí jedno doplnění navíc.
#
#   CONTENT_SCHEDULE_ENABLED=false   plánovač úplně vypne
#   CONTENT_SCHEDULE_HOUR=4          hodina denního běhu (0-23, čas serveru)
#   CONTENT_SCHEDULE_MINUTE=0        minuta denního běhu (0-59)
#   CONTENT_SCHEDULE_STARTUP_DELAY_MS=30000  prodleva prvního doplnění po startu (ms)
#   CONTENT_BULK_DAILY_LIMIT=150     denní strop hromadných úloh, zbytek kvóty zůstává
#                                    požadavkům uživatelů (0 = hromadné doplňování vypnuté)
# ---------------------------------------------------------------------------
CONTENT_SCHEDULE_ENABLED=true
CONTENT_SCHEDULE_HOUR=4
CONTENT_SCHEDULE_MINUTE=0
CONTENT_SCHEDULE_STARTUP_DELAY_MS=30000
CONTENT_BULK_DAILY_LIMIT=150
