# Připojení k databázi MongoDB (u hostingu ji najdete ve svém clusteru)
MONGO_URI=

# Tajný klíč pro podepisování přihlašovacích tokenů
JWT_SECRET=

# Port, na kterém server poslouchá
PORT=5000

# Volitelný token pro Hugging Face API (bez něj stačí veřejná data)
HUGGINGFACE_API_KEY=

# ---------------------------------------------------------------------------
# Generování českých popisů modelů
#
# Klíč je volitelný. Když je nastavený, aplikace si chybějící popisy doplňuje
# i sama za běhu (až 3 při jednom načtení výpisu), takže funguje i po nasazení.
# Bez klíče se používá jen ruční skript npm run generate:descriptions.
#
# Vyhovuje jakákoli služba s OpenAI kompatibilním rozhraním. Příklady:
#
#   Groq (free tier, bez platební karty)
#     SUMMARY_API_URL=https://api.groq.com/openai/v1
#     SUMMARY_MODEL=openai/gpt-oss-120b   (případně openai/gpt-oss-20b nebo qwen/qwen3.8-27b)
#     SUMMARY_REASONING_EFFORT=low         (u reasoning modelů zkrátí přemýšlení; jiné služby parametr neznají, tam ho vynechte)
#
#   Grok od xAI
#     SUMMARY_API_URL=https://api.x.ai/v1
#     SUMMARY_MODEL=<název modelu podle dokumentace xAI>
#
#   Lokální Ollama (zdarma, bez klíče)
#     SUMMARY_API_URL=http://localhost:11434/v1
#     SUMMARY_MODEL=qwen2.5:7b
# ---------------------------------------------------------------------------
SUMMARY_API_KEY=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
SUMMARY_API_URL=https://api.groq.com/openai/v1
SUMMARY_MODEL=openai/gpt-oss-120b
