# Připojení k databázi MongoDB (u hostingu ji najdete ve svém clusteru)
MONGO_URI=

# Tajný klíč pro podepisování přihlašovacích tokenů
JWT_SECRET=

# Port, na kterém server poslouchá
PORT=5000

# Volitelný token pro Hugging Face API (bez něj stačí veřejná data)
HUGGINGFACE_API_KEY=

# ---------------------------------------------------------------------------
# Generování českých textů (popisky a přehledy z dokumentace)
#
# POZOR: tento soubor je uložený v gitu, takže sem nikdy nepatří skutečný klíč.
# Ten patří jen do .env (ten je ignorovaný). Zde nechávejte prázdné hodnoty.
#
# Poskytovatelů může být víc: první bez čísla, záložní s _2, _3… (SUMMARY_API_URL_2,
# SUMMARY_MODEL_2, SUMMARY_API_KEY_2). Zkoušejí se popořadě, takže vyčerpaný limit
# u jednoho provoz nezastaví. Klíč se u stejné služby dědí z prvního poskytovatele.
#
# Klíč je volitelný. Když je nastavený, aplikace si popisky pro modely, které jsou
# na stránce vidět, doplňuje sama za běhu (nejvýš tři na jedno vyžádání) a ukládá je
# do databáze, takže se každý model generuje jen jednou.
#
# Vyhovuje jakákoli služba s OpenAI kompatibilním rozhraním. Příklady:
#
#   Groq (zdarma, bez karty) - denní limit 200 000 tokenů platí pro každý model
#   zvlášť, proto se vyplatí mít v záloze druhý model:
#     SUMMARY_API_URL=https://api.groq.com/openai/v1
#     SUMMARY_MODEL=openai/gpt-oss-120b
#     SUMMARY_REASONING_EFFORT=low         (jen gpt-oss modely; jiné služby parametr neznají)
#     SUMMARY_API_URL_2=https://api.groq.com/openai/v1
#     SUMMARY_MODEL_2=openai/gpt-oss-20b
#     SUMMARY_REASONING_EFFORT_2=low
#
#   Google Gemini (zdarma, bez platební karty, přes 500 požadavků denně)
#     SUMMARY_API_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     SUMMARY_API_KEY=<klíč z https://aistudio.google.com/apikey>
#     SUMMARY_MODEL=gemini-3.5-flash-lite
#
#   OpenRouter (zdarma 50 požadavků denně, 1 000 po zaplacení 10 USD)
#     SUMMARY_API_URL=https://openrouter.ai/api/v1
#     SUMMARY_MODEL=meta-llama/llama-3.3-70b-instruct:free
#
#   xAI Grok (placený)
#     SUMMARY_API_URL=https://api.x.ai/v1
#     SUMMARY_MODEL=<název modelu podle dokumentace xAI>
#
#   Lokální Ollama (zdarma a bez omezení, klíč nepotřebuje)
#     SUMMARY_API_URL=http://localhost:11434/v1
#     SUMMARY_MODEL=qwen3:8b
# ---------------------------------------------------------------------------
SUMMARY_API_KEY=
SUMMARY_API_URL=https://api.groq.com/openai/v1
SUMMARY_MODEL=openai/gpt-oss-120b
